# Copy this file to .env.local and fill in the two values from Supabase:
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only - never put a NEXT_PUBLIC_ prefix on this one, and never use it in a
# "use client" component. Lets the birthday cron job write to the database directly.
# Find it in Supabase: Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Any long random string you make up yourself (e.g. run `openssl rand -hex 32`).
# Set the same value in Vercel > Project Settings > Environment Variables.
# Vercel automatically sends it as "Authorization: Bearer <value>" when it
# triggers the daily cron job, so the route can check the request is really from Vercel.
CRON_SECRET=your-own-random-secret

# Who sends the messages: "simulation" (default - nothing is actually sent, it's
# just written to the log with status "Simulado"), "brevo" or "twilio" (real SMS).
# Keep "simulation" until you're ready to send real SMS to real clients.
MESSAGING_MODE=simulation

# Only needed when MESSAGING_MODE=brevo. Create the key in Brevo: your name
# (top right) > SMTP & API > API keys > Generate a new API key.
BREVO_API_KEY=your-brevo-api-key
# The sender name shown on the phone: up to 11 letters/digits, no spaces.
BREVO_SMS_SENDER=Vitral

# Only needed when MESSAGING_MODE=twilio (the other provider). Find these in the Twilio Console
# (https://console.twilio.com) - Account SID and Auth Token are on the
# dashboard home page.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# The sender: on a trial account, your Twilio phone number in international
# format (+1...); once the account is upgraded, a name of up to 11 letters/digits
# (Vitral). A Messaging Service id (MG...) also works.
TWILIO_SMS_SENDER=Vitral

# Optional: the number already filled in for "Enviar teste" on the campaign page.
TEST_PHONE_NUMBER=912345678

# Set to "off" to leave out the unsubscribe link at the end of every SMS, to save
# SMS credits while testing. Remove it (or set "on") before messaging real
# clients: every marketing SMS needs an easy way to opt out.
SMS_UNSUBSCRIBE_LINK=on

# The public base URL of this site, no trailing slash. Used to build the
# unsubscribe link that's added to every SMS. Locally this is your dev
# server; in Vercel, use your real deployment URL (or custom domain).
APP_URL=http://localhost:3000
